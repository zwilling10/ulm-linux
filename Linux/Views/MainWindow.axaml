<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ULM.Linux.ViewModels"
        xmlns:linux="using:ULM.Linux"
        xmlns:conv="using:ULM.Linux.Converters"
        x:Class="ULM.Linux.Views.MainWindow"
        x:DataType="vm:LinuxMainViewModel"
        Title="Universal Linux Manager"
        Width="1160" Height="750" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:TooltipGateConverter x:Key="TooltipGateConverter"/>
    </Window.Resources>

    <!--
        Struktur an Windows' Views/MainWindow.xaml angeglichen (Phase A, siehe
        docs/superpowers/... Plan "ULM Linux: MainWindow-Optik + -Verhalten an Windows angleichen"):
        Kopfzeile / Such-&-Sprachzeile (Linux-eigen, siehe Kommentar unten) / Laufwerks-Toolbar /
        Tabs (ISO-Auswahl mit gruppierter Spalten-Liste, Protokoll, Status) / Aktionsleiste /
        Statusleiste. Farben/Stile kommen aus Themes/DarkTheme.axaml (App.axaml).
    -->
    <Grid RowDefinitions="64,Auto,Auto,*,Auto,28">

        <!-- ── Kopfzeile ──────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{DynamicResource BrushHeaderBar}">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="18,0">
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="8"
                            Background="{DynamicResource BrushBlue}" Margin="0,0,12,0">
                        <TextBlock Text="UL" Foreground="White" FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Universal Linux Manager" Foreground="White"
                                   FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="{Binding HeaderSubtitle}" Foreground="{DynamicResource BrushDim}"
                                   FontSize="10"/>
                    </StackPanel>
                </StackPanel>

                <!-- Startphasen-Hinweis: pulsierender Text, sichtbar solange der automatische
                     Online-Versionscheck läuft (Windows-Pendant: ScanInProgress/ScanHintText,
                     dort zusätzlich mit rotierendem Spinner-Icon — hier bewusst auf den
                     pulsierenden Text reduziert, gleiche Funktion/Sichtbarkeit). -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Center" IsVisible="{Binding ScanInProgress}">
                    <TextBlock x:Name="ScanHintTb" VerticalAlignment="Center" Text="{Binding ScanHintFullText}"
                               Foreground="#FFC107" FontSize="10.5" FontWeight="SemiBold">
                        <TextBlock.Styles>
                            <Style Selector="TextBlock#ScanHintTb">
                                <Style.Animations>
                                    <Animation Duration="0:0:0.85" IterationCount="INFINITE" PlaybackDirection="Alternate">
                                        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                                        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.35"/></KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </TextBlock.Styles>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Classes="ghost-onbar" Content="{Binding SettingsLabel}" Width="140"
                            Margin="0,0,8,0" Click="BtnSettings_Click"/>
                    <Button Classes="ghost-onbar" Content="{Binding HelpLabel}" Width="80"
                            Click="BtnHelp_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Such-/Sprachzeile ──────────────────────────────────────── -->
        <!-- Kein Windows-Pendant (dort per Einstellungen-Dialog geregelt bzw. keine Suche
             vorhanden) — bleibt bewusst als eigene, kompakte Zeile erhalten statt ersatzlos entfernt
             zu werden: Katalog-Refresh und Sprachumschalter sind bestehende, funktionierende
             Linux-Features ohne Windows-Äquivalent an dieser Stelle. -->
        <Border Grid.Row="1" Background="{DynamicResource BrushWhite}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" Margin="18,8">
                <TextBox Grid.Column="0" Watermark="{Binding SearchPlaceholder}" Text="{Binding SearchText}"
                          Margin="0,0,8,0"/>
                <Button Grid.Column="1" Classes="ghost" Content="{Binding RefreshLabel}"
                        Command="{Binding RefreshCommand}"/>
            </Grid>
        </Border>

        <!-- ── Toolbar: Laufwerk / Ventoy ─────────────────────────────── -->
        <Border Grid.Row="2" Background="{DynamicResource BrushWhite}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,280,36,Auto,Auto,*,Auto" Margin="18,10">
                <TextBlock Grid.Column="0" Text="{Binding TargetDriveLabel}" FontSize="9" FontWeight="Bold"
                           Foreground="{DynamicResource BrushDim}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <ComboBox Grid.Column="1" ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="linux:LinuxBlockDevice">
                            <TextBlock Text="{Binding DeviceNode}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Grid.Column="2" Classes="ghost" Content="↻" FontSize="16" Width="32" Height="32" Padding="0"
                        Command="{Binding RefreshCommand}"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Classes="success" Content="{Binding VentoyInstallLabel}"
                            Command="{Binding RequestVentoyInstallCommand}" Margin="0,0,8,0"/>
                    <Button Classes="success" Content="{Binding VentoyUpdateLabel}"
                            Command="{Binding RequestVentoyUpdateCommand}"/>
                </StackPanel>

                <CheckBox Grid.Column="4" Content="{Binding SecureBootLabel}" IsChecked="{Binding SecureBootEnabled}"
                          Margin="14,0,0,0" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="6" Text="{Binding DriveInfoText}" Foreground="{DynamicResource BrushBlue}"
                           FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- ── Bestätigungsleiste vor destruktiven Ventoy-Aktionen (unverändert aus Phase 2) ── -->
        <Border Grid.Row="2" Grid.RowSpan="1" VerticalAlignment="Bottom" Margin="18,0,18,-1"
                IsVisible="{Binding PendingConfirmationMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="#FFF3CD" BorderBrush="#FFCA2C" BorderThickness="1" Padding="10" CornerRadius="4"
                ZIndex="10">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding PendingConfirmationMessage}" TextWrapping="Wrap" Foreground="#664D03" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="danger" Content="{Binding VentoyConfirmYesLabel}" Command="{Binding ConfirmVentoyCommand}"/>
                    <Button Classes="ghost" Content="{Binding VentoyConfirmCancelLabel}" Command="{Binding CancelVentoyCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Haupt-Inhalt ────────────────────────────────────────────── -->
        <TabControl Grid.Row="3">

            <TabItem Header="{Binding TabIsoSelectionLabel}">
                <Grid RowDefinitions="Auto,*">
                    <!-- Spaltenbreiten "28,36,*,100,100,100" spiegeln EXAKT das EntryTemplate-Grid unten
                         (gleiche Einrückung 28px vor der Checkbox), damit Kopf- und Datenspalten fluchten. -->
                    <Border Grid.Row="0" Background="{DynamicResource BrushCard}"
                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="4,7">
                        <Grid ColumnDefinitions="28,36,*,100,100,100">
                            <TextBlock Grid.Column="2" Text="{Binding ColumnDistributionLabel}"
                                       FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushMid}"/>
                            <TextBlock Grid.Column="3" Text="{Binding ColumnLocalLabel}"
                                       FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushMid}"/>
                            <TextBlock Grid.Column="4" Text="{Binding ColumnOnStickLabel}"
                                       FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushMid}"/>
                            <TextBlock Grid.Column="5" Text="{Binding ColumnCurrentLabel}"
                                       FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushMid}"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" Background="{DynamicResource BrushWhite}">
                        <ItemsControl ItemsSource="{Binding Groups}" Margin="4,2,4,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CategoryGroup">
                                    <StackPanel Margin="0,0,0,2">
                                        <!-- Kategorie-Checkbox bewusst weit links (Padding 8 statt 14) — die Distro-
                                             Checkboxen darunter sind zusätzlich per Grid-Spalte eingerückt (siehe
                                             EntryTemplate-Grid "28,36,..."), damit die Eltern/Kind-Hierarchie
                                             (Sammel-Checkbox oben, einzelne Einträge darunter) optisch erkennbar ist
                                             (Nutzerfund: "Hauptkategorie weiter links, Distros darunter versetzt"). -->
                                        <Border Background="{DynamicResource BrushCard}" Padding="8,8" Margin="0,6,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsThreeState="True" IsChecked="{Binding AllSelected, Mode=TwoWay}"
                                                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding CategoryLabel}" FontWeight="Bold" FontSize="13.5"
                                                           Foreground="{DynamicResource BrushHeader}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Entries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:LinuxIsoRow">
                                                    <Border Padding="0,5" BorderBrush="{DynamicResource BrushBorder}"
                                                            BorderThickness="0,0,0,1">
                                                        <Grid ColumnDefinitions="28,36,*,100,100,100">
                                                            <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}"
                                                                      VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Name}"
                                                                       Foreground="{Binding ForegroundBrush}"
                                                                       FontSize="12.5" FontWeight="SemiBold"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                                <!-- Nutzerfund (2026-09-08): "Checkbox (Mouse over) hat keine
                                                                     Funktion, wird auch bei Abwahl angezeigt" — ShowInfoOnHover
                                                                     (Fenster-DataContext) war nie mit TipTooltip (Zeilen-
                                                                     DataContext) verdrahtet. MultiBinding kombiniert beide,
                                                                     reagiert live auf die Checkbox. -->
                                                                <ToolTip.Tip>
                                                                    <MultiBinding Converter="{StaticResource TooltipGateConverter}">
                                                                        <Binding Path="TipTooltip"/>
                                                                        <Binding Path="$parent[Window].((vm:LinuxMainViewModel)DataContext).ShowInfoOnHover"/>
                                                                    </MultiBinding>
                                                                </ToolTip.Tip>
                                                            </TextBlock>
                                                            <!-- Spalte 3 ist fest 100px breit (siehe ColumnDefinitions oben) — der
                                                                 Live-Fortschrittstext während eines Downloads ("8% ↓ host.tld —
                                                                 53 MB/2.9 GB · 26 MB/s") ist deutlich länger als "nicht lokal" und
                                                                 lief ohne feste Breite/Trimming über die Spaltengrenze hinaus in die
                                                                 Nachbarspalten/-zeilen (Nutzerfund 2026-09-04, Screenshot). Feste
                                                                 Width + TextTrimming zwingt ihn in die Spalte, ToolTip zeigt den
                                                                 vollen Text bei Bedarf. -->
                                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding LocalStatus}" Width="80"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip.Tip="{Binding LocalStatus}"
                                                                           Foreground="{DynamicResource BrushMid}"
                                                                           FontSize="11.5" VerticalAlignment="Center"/>
                                                                <!-- "⚡ schneller"-Button — Windows-Pendant: DownloadSlotArgs.
                                                                     CanRequestFasterMirror im DownloadProgressDialog. Ruft
                                                                     DownloadWorker.RequestFasterMirror(entryName) über den
                                                                     Hauptfenster-DataContext auf (diese Zeile hat als
                                                                     x:DataType nur LinuxIsoRow, kein eigener Worker-Zugriff). -->
                                                                <Button Content="⚡" FontSize="10" Padding="4,0" Margin="4,0,0,0"
                                                                        Classes="ghost"
                                                                        IsVisible="{Binding CanRequestFasterMirror}"
                                                                        ToolTip.Tip="{Binding $parent[Window].((vm:LinuxMainViewModel)DataContext).FasterMirrorTooltip}"
                                                                        Command="{Binding $parent[Window].((vm:LinuxMainViewModel)DataContext).RequestFasterMirrorCommand}"
                                                                        CommandParameter="{Binding Entry.Name}"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="4" Text="{Binding UsbStatus}"
                                                                       Foreground="{DynamicResource BrushMid}"
                                                                       FontSize="11.5" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="5" Text="{Binding VersionStatus}"
                                                                       Foreground="{DynamicResource BrushMid}"
                                                                       FontSize="11.5" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding TabLogLabel}">
                <Grid RowDefinitions="*,Auto">
                    <ScrollViewer Grid.Row="0" Background="{DynamicResource BrushWhite}">
                        <ItemsControl ItemsSource="{Binding LogEntries}" Margin="10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}" FontFamily="Consolas,Courier New,monospace"
                                               FontSize="11" Foreground="{DynamicResource BrushHeader}" Margin="0,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Row="1" Classes="ghost" Content="{Binding LogClearLabel}"
                            HorizontalAlignment="Right" Margin="8"
                            Command="{Binding ClearLogCommand}"/>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding TabStatusLabel}">
                <ScrollViewer Background="{DynamicResource BrushWhite}">
                    <StackPanel Margin="12">
                        <TextBlock Text="{Binding StatusCurrentOperationLabel}" FontWeight="Bold" FontSize="13"
                                   Foreground="{DynamicResource BrushMid}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding StatusIdleLabel}" FontSize="12" Margin="0,0,0,12"
                                   IsVisible="{Binding !HasAnyStatus}"/>
                        <StackPanel IsVisible="{Binding HasAnyStatus}" Margin="0,0,0,12" Spacing="4">
                            <TextBlock Text="{Binding DownloadStatus}" FontSize="12"
                                       IsVisible="{Binding DownloadStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="{Binding CopyStatus}" FontSize="12"
                                       IsVisible="{Binding CopyStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="{Binding UpdateCheckStatus}" FontSize="12"
                                       IsVisible="{Binding UpdateCheckStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="{Binding UrlCheckStatus}" FontSize="12"
                                       IsVisible="{Binding UrlCheckStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="{Binding VentoyStatus}" FontSize="12" TextWrapping="Wrap"
                                       IsVisible="{Binding VentoyStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- ── Aktionsleiste ──────────────────────────────────────────── -->
        <Border Grid.Row="4" Background="{DynamicResource BrushWhite}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0">
            <StackPanel Margin="12,8" Spacing="6">
                <!-- Windows-Pendant: BtnDownload_Click im Code-behind (nicht Command-gebunden) —
                     die Dialogkette (Kopiermodus/Freispeicher/Slots-Geschwindigkeitstest) braucht
                     ein Owner-Fenster, gehört deshalb wie unter Windows in die View statt ins VM. -->
                <StackPanel Orientation="Horizontal">
                    <Button Classes="primary" Content="{Binding ActionDownloadLabel}" Width="180"
                            Click="BtnDownload_Click" IsEnabled="{Binding !IsBusy}" Margin="0,0,8,0"/>
                    <Button Classes="warning" Content="{Binding ActionCheckUpdatesLabel}" Width="150"
                            Command="{Binding CheckUpdatesCommand}"/>
                    <TextBlock Text="{Binding DownloadPercent, StringFormat={}{0}%}" VerticalAlignment="Center"
                               Foreground="{DynamicResource BrushBlue}" FontSize="11.5" Margin="8,0"
                               IsVisible="{Binding IsBusy}"/>
                    <Button Classes="ghost" Content="{Binding ActionCancelDownloadLabel}" Width="110"
                            Command="{Binding CancelDownloadCommand}" IsVisible="{Binding IsBusy}"/>
                </StackPanel>

                <!-- "ExpertBar": die restlichen Windows-Werkzeuge sichtbar, aber ohne Linux-Backing
                     deaktiviert (Phase B füllt diese, siehe Plan) — "Auf Stick kopieren" bleibt aktiv,
                     das Feature existiert bereits (Phase 2). -->
                <StackPanel Orientation="Horizontal">
                    <Button Classes="ghost" Content="{Binding ActionCheckUrlsLabel}" Width="130" Margin="0,0,8,0"
                            Command="{Binding CheckUrlsCommand}"/>
                    <Button Classes="ghost" Content="{Binding ActionSearchIsoLabel}" Width="130" Margin="0,0,8,0"
                            Click="BtnSearchIso_Click"/>
                    <Button Classes="ghost" Content="{Binding ActionDatabaseLabel}" Width="130" Margin="0,0,8,0"
                            Click="BtnDatabase_Click"/>
                    <Button Classes="ghost" Content="{Binding ActionDbHealthCheckLabel}" Width="170" Margin="0,0,8,0"
                            Command="{Binding RunHealthCheckCommand}"/>
                    <Button Classes="ghost" Content="{Binding ActionCopyToStickLabel}" Width="210" Margin="0,0,8,0"
                            Command="{Binding CopyToStickCommand}"/>
                    <Button Classes="ghost" Content="{Binding ActionVerifyIntegrityLabel}" Width="160" Margin="0,0,8,0"
                            Command="{Binding VerifyIntegrityCommand}"/>
                    <Button Classes="ghost" Content="{Binding ActionGitHubTokenLabel}" Width="130"
                            Click="BtnGitHubToken_Click"/>
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto">
                    <ProgressBar Grid.Column="0" Height="5" Maximum="100" Value="{Binding DownloadPercent}"
                                 VerticalAlignment="Center" IsVisible="{Binding IsBusy}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ── Statusleiste ────────────────────────────────────────────── -->
        <Border Grid.Row="5" Background="{DynamicResource BrushCard}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto" Margin="12,0">
                <TextBlock Grid.Column="0" Text="{Binding StatusBarText}" VerticalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource BrushMid}" TextTrimming="CharacterEllipsis"/>
                <CheckBox Grid.Column="1" Content="{Binding ShowInfoOnHoverLabel}"
                          IsChecked="{Binding ShowInfoOnHover}" FontSize="10.5" VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>
</Window>
